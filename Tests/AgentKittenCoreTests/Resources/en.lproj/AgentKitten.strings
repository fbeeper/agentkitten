"sessionState.defaultPromptGuidance" = "Session state is an optional scratchpad for small facts worth reusing across turns or execution steps. Use it only when a fact should be remembered or retrieved later. Do not create generic bookkeeping entries, and do not store plan outlines, goal restatements, or final answers unless the user explicitly asks for that. Prefer the fewest state reads and writes needed.";
"sessionState.readOnlyPromptGuidance" = "Session state is read-only in this session. You may inspect it, but you cannot modify it.";
"sessionState.getStateDescription" = "Reads a value from the session scratchpad by key. Use this to recover facts,\nintermediate results, or todo state saved earlier in the same session.\nReturns the stored string value.";
"sessionState.getStateKeyDescription" = "Scratchpad key to read.";
"sessionState.listStateKeysDescription" = "Lists the keys currently available in the session scratchpad. Use this when you need to inspect what state exists before reading specific keys.";
"sessionState.setStateDescription" = "Writes a string value into the session scratchpad under a key.";
"sessionState.setStateKeyDescription" = "Scratchpad key to write.";
"sessionState.setStateValueDescription" = "String value to store.";
"sessionState.removeStateDescription" = "Removes a value from the session scratchpad by key. Use this when scratchpad\ninformation is no longer needed or would become stale.";
"sessionState.removeStateKeyDescription" = "Scratchpad key to remove.";
"validation.judgeSystemPromptFormat" = "You are a validation judge for another AI assistant's response.\n\nEvaluate the candidate result against the original user request and the validation criteria below.\n\nValidation criteria:\n%@\n\nReturn one structured decision:\n- pass: the result satisfies the criteria\n- fail: the result is invalid and should be rejected\n- feedback: the result could be improved by another assistant attempt\n\nPrefer feedback over fail when a revised answer could satisfy the criteria. Use fail only when the result should be rejected rather than retried.";
"validation.judgeVerdictGuidance" = "Return one structured decision:\n- pass: the result satisfies the criteria\n- fail: the result is invalid and should be rejected\n- feedback: the result could be improved by another assistant attempt";
"validation.judgeUserPromptFormat" = "Original user message:\n%1$@\n\nCandidate result:\n%2$@\n\nEvaluate the candidate result against the criteria from your system instructions and return the structured verdict.";
"validation.verdictDescription" = "The validation verdict.";
"validation.messageDescription" = "Reason for fail or feedback text for retry.";
"validation.rejectedFallback" = "Judge rejected the result.";
"validation.revisedFallback" = "Judge requested a revised result.";
